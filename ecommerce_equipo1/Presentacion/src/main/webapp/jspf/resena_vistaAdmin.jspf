<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<c:forEach var="r" items="${resenas}">
    
    <div class="review-card">
        
        <div class="card-header">
            
            <div class="info-group">
                <label>Usuario</label>
                <p>${r.cliente.nombre}</p>
            </div>

            <div class="info-group">
                <label>Producto</label>
                <p>${r.producto.nombre}</p>
            </div>

            <div class="info-group">
                <label>Calificación</label>
                <div class="stars">
                    <c:forEach begin="1" end="${r.calificacion}">&#9733;</c:forEach>
                </div>
            </div>

            <div class="actions">
                <form action="${pageContext.request.contextPath}/admin/adminResenas" method="post" style="display:inline;">
                    <input type="hidden" name="idResena" value="${r.id}">
                    <input type="hidden" name="accion" value="eliminar">
                    <button type="submit" class="btn-eliminar" onclick="return confirm('¿Eliminar?');">Eliminar</button>
                </form>

                <form action="${pageContext.request.contextPath}/admin/adminResenas" method="post" style="display:inline;">
                    <input type="hidden" name="idResena" value="${r.id}">
                    <input type="hidden" name="accion" value="moderar">
                    <button type="submit" class="btn-moderar">Moderar</button>
                </form>
            </div>
        </div>

        <div class="card-body">
            <p>${r.comentario}</p>
        </div>
        
    </div>
</c:forEach>