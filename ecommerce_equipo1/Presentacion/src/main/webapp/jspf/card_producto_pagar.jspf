<%@ page pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %> <!-- Necesario para el formato -->

<div class="summary-item">
    <img src="${c.direccionImagen}" alt="${c.nombreProducto}"
         class="product-image">
    <div class="product-details">
        <p class="product-name">${c.nombreProducto}</p>
        <p class="product-meta">Color: <span class="color-dot" style="background-color: ${c.colorHex};"></span></p>
        <p class="product-meta">Talla: ${c.talla}</p>
        <p class="product-meta">Cantidad: ${c.cantidad}</p>
    </div>
    <!-- Aplicamos el formato de dos decimales -->
    <p class="product-price">$<fmt:formatNumber value="${c.precio}" pattern="0.00" /></p>
</div>