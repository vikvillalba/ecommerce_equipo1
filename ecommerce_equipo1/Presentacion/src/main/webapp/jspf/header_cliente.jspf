<%@ page pageEncoding="UTF-8" %>
<link rel="stylesheet" href="CSS/header_cliente.css">
    <header>
        <div class="nav-content">
            <div class="nav-left-icons">
                <button class="left-icon" title="Catálogo" onclick="window.location.href = '${pageContext.request.contextPath}/CatalogoServlet'">
                    <img src="img/Catalog-icon.png" alt="Catalogo" class="nav-icon">
                </button>
                <div class="search-container">
                    <input type="text" 
                           id="buscar" 
                           placeholder="Busca por nombre, categoría..."
                           autocomplete="off">
                        <button type="button">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-small">
                                <circle cx="11" cy="11" r="8" />
                                <path d="m21 21-4.3-4.3" />
                            </svg>
                        </button>
                        <div id="resultados"></div>
                </div>
            </div>
            <div class="logo-center">
                <img src="img/Logo.png" alt="Logo">
            </div>
            <div class="nav-right-icons">
                <button class="right-icon" title="Carrito de compras" onclick="window.location.href = '${pageContext.request.contextPath}/carrito'">
                    <img src="img/Cart-icon.png" alt="Carrito de compras" class="nav-icon">
                </button>
                <button class="right-icon" title="Cuenta" onclick="location.href = 'ModificarPerfilServlet'">
                    <img src="img/User-icon.png" alt="Cuenta" class="nav-icon">
                </button>
            </div>
        </div>
        <div class="lace-border-header"></div>
    </header>

    <script>
        var input = document.getElementById('buscar');
        var resultados = document.getElementById('resultados');
        var tiempo = null;
        var contexto = '${pageContext.request.contextPath}';

        input.addEventListener('input', function () {
            clearTimeout(tiempo);
            var texto = input.value.trim();
            if (texto.length < 2) {
                resultados.style.display = 'none';
                return;
            }
            tiempo = setTimeout(function () {
                fetch(contexto + '/BusquedaServlet?termino=' + texto)
                        .then(function (res) {
                            return res.json();
                        })
                        .then(function (productos) {
                            mostrar(productos);
                        });
            }, 300);
        });

        function mostrar(productos) {
            if (productos.length === 0) {
                resultados.innerHTML = '<div class="vacio">No se encontraron productos</div>';
                resultados.style.display = 'block';
                return;
            }
            var html = '';
            for (var i = 0; i < productos.length; i++) {
                var p = productos[i];
                html += '<div class="item" onclick="ir(' + p.id + ')">';
                html += '<img src="' + contexto + '/' + p.imagen + '" onerror="this.src=\'' + contexto + '/img/placeholder.jpg\'">';
                html += '<div class="info">';
                html += '<div class="nombre">' + p.nombre + '</div>';
                html += '<div class="precio">$' + p.precio.toFixed(2) + '</div>';
                html += '</div></div>';
            }
            resultados.innerHTML = html;
            resultados.style.display = 'block';
        }

        function ir(id) {
            window.location.href = contexto + '/Producto?id=' + id;
        }

        document.addEventListener('click', function (e) {
            if (e.target !== input && e.target !== resultados) {
                resultados.style.display = 'none';
            }
        });
    </script>