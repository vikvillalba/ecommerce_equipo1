<%@ page pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<div class="product-card">
    
    <img src="${not empty p.imagen ? p.imagen : pageContext.request.contextPath.concat('/img/placeholder.jpg')}" 
         alt="${p.nombre}" 
         class="prod-thumb"
         onerror="this.src='${pageContext.request.contextPath}/img/placeholder.jpg'"> <div class="prod-info">
        <span class="label">Producto</span>
        <h3>${p.nombre}</h3>
        <span style="font-size: 0.9em; color: #ddd;">$${p.precio} | Stock: ${p.existencias}</span>
    </div>

    <div class="prod-actions">
        <form action="/admin/categorias" method="POST" style="display:inline;">
            <input type="hidden" name="accion" value="eliminar">
            <input type="hidden" name="id" value="${p.id}">
            <button type="submit" class="btn-eliminar" onclick="return confirm('¿Borrar este producto?');">Eliminar</button>
        </form>

        <button type="button" class="btn-editar" onclick="editarProducto(${p.id}, '${p.nombre}', '${p.descripcion}', ${p.precio}, ${p.existencias})">
            Editar
        </button>
    </div>
</div>